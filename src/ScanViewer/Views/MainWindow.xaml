<Window x:Class="ScanViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScanViewer"
        xmlns:vm="clr-namespace:ScanViewer.ViewModels"
        mc:Ignorable="d"
        Title="Scan Data Viewer - 点呼データ閲覧ツール" 
        Height="720" Width="980"
        MinHeight="550" MinWidth="800"
        Background="{StaticResource WindowBackgroundBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ReloadFileCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ReloadFileCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCsvCommand}"/>
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopyAllCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding OpenContainingFolderCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: MenuBar -->
            <RowDefinition Height="Auto"/> <!-- 1: ToolBar / Command Bar -->
            <RowDefinition Height="Auto"/> <!-- 2: KPI Metrics Strip -->
            <RowDefinition Height="*"/>    <!-- 3: Main Workspace -->
            <RowDefinition Height="Auto"/> <!-- 4: StatusBar -->
        </Grid.RowDefinitions>

        <!-- 0: Modern MenuBar -->
        <Menu Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
              BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="4,2">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="開く(_O)..." InputGestureText="Ctrl+O" Command="{Binding OpenFileCommand}"/>
                <MenuItem Header="再読み込み(_R)" InputGestureText="F5" Command="{Binding ReloadFileCommand}"/>
                <MenuItem Header="保存先フォルダを開く(_D)" InputGestureText="Ctrl+D" Command="{Binding OpenContainingFolderCommand}"/>
                <Separator/>
                <MenuItem Header="CSV形式でエクスポート(_E)..." InputGestureText="Ctrl+E" Command="{Binding ExportCsvCommand}"/>
                <Separator/>
                <MenuItem Header="終了(_X)" InputGestureText="Alt+F4" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="TSV形式でコピー(_C)" InputGestureText="Ctrl+Shift+C" Command="{Binding CopyAllCommand}"/>
                <MenuItem Header="検索条件をクリア(_L)" InputGestureText="Esc" Command="{Binding ClearSearchCommand}"/>
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="重複スキャンのみ表示(_D)" IsCheckable="True" IsChecked="{Binding FilterDuplicatesOnly, Mode=TwoWay}"/>
                <MenuItem Header="名簿未登録のみ表示(_U)" IsCheckable="True" IsChecked="{Binding FilterUnregisteredOnly, Mode=TwoWay}"/>
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="バージョン情報(_A)..." Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!-- 1: ToolBar / Action Strip -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,7">
            <DockPanel LastChildFill="True">
                <!-- Left Action Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="ファイルを開く" Command="{Binding OpenFileCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="再読み込み" Command="{Binding ReloadFileCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="CSVエクスポート" Command="{Binding ExportCsvCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="リストをコピー" Command="{Binding CopyAllCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,12,0"/>
                    
                    <Rectangle Width="1" Height="20" Fill="{StaticResource DividerBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    
                    <!-- File info indicator -->
                    <Border Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="3" Padding="8,4" VerticalAlignment="Center"
                            ToolTip="{Binding SelectedFilePath}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="  (" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FileSizeText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text=")" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Filters & Search Box -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Filter Checkboxes -->
                    <CheckBox Content="重複のみ" IsChecked="{Binding FilterDuplicatesOnly, Mode=TwoWay}" 
                              VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"/>
                    <CheckBox Content="未登録のみ" IsChecked="{Binding FilterUnregisteredOnly, Mode=TwoWay}" 
                              VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"/>

                    <!-- Search Box with Clear Button -->
                    <Grid Width="230">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBoxStyle}" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,4,24,4"/>
                        <TextBlock Text="学籍番号・氏名で絞り込み..." IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="✕" Command="{Binding ClearSearchCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="20" Height="20" Margin="0,0,4,0"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                Cursor="Hand" ToolTip="検索をクリア">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2: KPI Metrics Strip -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" 
                BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Metric 1: Total -->
                    <Border Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="総スキャン: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                            <TextBlock Text=" 件" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Metric 2: Unique -->
                    <Border Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ユニーク: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding UniqueCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                            <TextBlock Text=" 名" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Metric 3: Duplicates -->
                    <Border BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDuplicates}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarningBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="重複スキャン: " FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDuplicates}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding DuplicateCount}" FontWeight="Bold" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDuplicates}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text=" 件" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDuplicates}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Metric 4: Unregistered -->
                    <Border BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnregistered}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="名簿未登録: " FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnregistered}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding UnregisteredCount}" FontWeight="Bold" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnregistered}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text=" 件" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnregistered}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Filtered Result Indicator -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="表示中: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding FilteredCount}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                    <TextBlock Text=" / " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding TotalCount}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    <TextBlock Text=" 件" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3: Main Workspace -->
        <Grid Grid.Row="3" Margin="10">
            <!-- State A: Empty Dropzone when no file is loaded -->
            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="2" CornerRadius="6" 
                    Background="{StaticResource SurfaceBrush}" Padding="40">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFileLoaded}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="スキャンデータファイル (.bin) をここにドラッグ＆ドロップ" 
                               FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="点呼アプリで保存された ids_*.bin 形式のバイナリファイルを解析・一覧表示します" 
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="ファイルを選択して開く (Ctrl+O)" Command="{Binding OpenFileCommand}" 
                            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"
                            Padding="20,8"/>
                </StackPanel>
            </Border>

            <!-- State B: Content View (Tabs for Detailed Table & Dense Tiles) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFileLoaded}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <TabControl SelectedIndex="{Binding SelectedViewIndex, Mode=TwoWay}"
                            Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="14,6"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- Tab 1: Detailed Table View -->
                    <TabItem Header="詳細テーブル">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" 
                                BorderThickness="1" CornerRadius="0,3,3,3">
                            <DataGrid Style="{StaticResource ModernDataGridStyle}" ItemsSource="{Binding DisplayItems}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnregistered}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDuplicate}" Value="True"/>
                                                    <Condition Binding="{Binding IsUnregistered}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{StaticResource WarningBgBrush}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>
                                    <!-- 1: Index / No. -->
                                    <DataGridTextColumn Header="No." Binding="{Binding Index}" Width="50">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 2: Status Badge -->
                                    <DataGridTemplateColumn Header="状態" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="1" CornerRadius="3" Padding="6,1" 
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUnregistered}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsDuplicate}" Value="True"/>
                                                                        <Condition Binding="{Binding IsUnregistered}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="{StaticResource WarningBgBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUnregistered}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsDuplicate}" Value="True"/>
                                                                            <Condition Binding="{Binding IsUnregistered}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 3: Student Number (Last 5) -->
                                    <DataGridTextColumn Header="学籍番号" Binding="{Binding FormattedLast5}" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas, monospace"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 4: Name -->
                                    <DataGridTemplateColumn Header="氏名" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding StudentName}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUnregistered}" Value="True">
                                                                    <Setter Property="Text" Value="(名簿未登録)"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 5: Code -->
                                    <DataGridTextColumn Header="コード" Binding="{Binding StudentCode}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas, monospace"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 6: Scan Count -->
                                    <DataGridTextColumn Header="スキャン回数" Binding="{Binding ScanCount}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="0,0,10,0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <!-- Tab 2: Compact Tiles View -->
                    <TabItem Header="簡易タイル">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" 
                                BorderThickness="1" CornerRadius="0,3,3,3" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DisplayItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1" CornerRadius="3" Margin="3" Padding="7,4" Width="105" Height="48">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUnregistered}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsDuplicate}" Value="True"/>
                                                                    <Condition Binding="{Binding IsUnregistered}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="{StaticResource WarningBgBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Index, StringFormat='No.{0}'}" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding FormattedLast5, StringFormat='学籍番号: {0}'}"/>
                                                            <TextBlock Text="{Binding StudentName, StringFormat='氏名: {0}'}"/>
                                                            <TextBlock Text="{Binding StudentCode, StringFormat='コード: {0}'}"/>
                                                            <TextBlock Text="{Binding StatusBadgeText, StringFormat='状態: {0}'}"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Top Row: Student Number and Duplicate Badge -->
                                                    <DockPanel Grid.Row="0" LastChildFill="False">
                                                        <TextBlock Text="{Binding FormattedLast5}" 
                                                                   FontFamily="Consolas, monospace" FontWeight="Bold" 
                                                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <Border DockPanel.Dock="Right" Background="{StaticResource WarningTextBrush}" 
                                                                CornerRadius="2" Padding="3,0"
                                                                Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding ScanCount, StringFormat='×{0}'}" 
                                                                       FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </DockPanel>

                                                    <!-- Bottom Row: Student Name -->
                                                    <TextBlock Grid.Row="1" Text="{Binding StudentName}" FontSize="10" 
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUnregistered}" Value="True">
                                                                        <Setter Property="Text" Value="未登録"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- 4: StatusBar -->
        <StatusBar Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" 
                   BorderThickness="0,1,0,0" Padding="8,3">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            
            <Separator Grid.Column="1" Margin="4,0"/>
            
            <StatusBarItem Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="更新日時: " Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding LastModifiedText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,12,0"/>
                    <TextBlock Text="点呼ビューア v2.0" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
